{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MolCanvas",
  "version": "0.3.0",
  "identifier": "app.molcanvas.editor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MolCanvas",
        "width": 1440,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost https://pubchem.ncbi.nlm.nih.gov"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "Free chemical structure editor",
    "longDescription": "MolCanvas is a free, modern chemical drawing app for organic and polymer chemists, with hundreds of preset molecules, monomers and polymer repeat units.",
    "copyright": "\u00a9 2026 Ashif",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "12.0",
      "signingIdentity": "-"
    }
  }
}
